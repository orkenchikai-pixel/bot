# Секреты генерируются командой:  npm run token
# Файл .env НЕ коммитьте в git и не пересылайте в мессенджерах.

# ───────── Claude (Anthropic) ─────────
# Ключ: https://platform.claude.com → API Keys. В консоли поставьте месячный лимит расходов.
ANTHROPIC_API_KEY=

# Модель и «усилие» рассуждений. claude-opus-5-5 — по умолчанию.
# Дешевле: claude-sonnet-5-5 или claude-haiku-5-5. effort: low | medium | high | xhigh | max
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=16000
# default — если модель откажется отвечать по соображениям безопасности, API сам повторит запрос на запасной модели
AGENT_FALLBACKS=default
AGENT_MAX_TOOL_ROUNDS=8

# ───────── WhatsApp Cloud API (Meta) ─────────
# Постоянный токен системного пользователя (Business Settings → System users)
WHATSAPP_ACCESS_TOKEN=
# App Secret приложения (developers.facebook.com → App settings → Basic) — для проверки подписи вебхука
WHATSAPP_APP_SECRET=
# Случайная строка от 16 символов; её же впишите в поле Verify token при настройке вебхука
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v27.0

# ───────── Безопасность и персональные данные ─────────
# Ключ шифрования базы (обязателен в production). Сохраните копию в надёжном месте: без него данные не прочитать.
DATA_ENCRYPTION_KEY=
# Любая случайная строка — секрет «канареечной метки», по которой ловится утечка промпта
CANARY_SECRET=
# true — писать тексты сообщений в логи. Только для отладки, потом выключить!
LOG_MESSAGE_TEXT=false
# true — если сервер за Caddy/Nginx (docker-compose ставит сам)
TRUST_PROXY=false
# Неудачных входов в админ-API с одного IP за 15 минут до блокировки
ADMIN_MAX_FAILED_LOGINS=10
# Сроки хранения (дней): переписка; записи до обезличивания; журнал аудита
RETENTION_MESSAGES_DAYS=180
RETENTION_APPOINTMENTS_DAYS=1095
RETENTION_AUDIT_DAYS=1095

# ───────── Антиспам ─────────
# Сообщений с одного номера: в минуту (сверх — не обрабатываются), в час и в сутки (сверх — блокировка)
SPAM_MAX_PER_MINUTE=12
SPAM_MAX_PER_HOUR=60
SPAM_MAX_PER_DAY=300
# Одинаковых сообщений подряд за 10 минут, которые ещё обрабатываются
SPAM_DUPLICATE_MAX=3
# Новых чатов в час на клинику (защита от атаки с множества номеров)
SPAM_NEW_CHATS_PER_HOUR=60
SPAM_BLOCK_HOURS=24
# Обрезать входящие длиннее (символов)
MAX_INBOUND_CHARS=2000
# Сообщения, досланные WhatsApp позже стольких часов после отправки, получает администратор, а не ИИ
STALE_MESSAGE_HOURS=12

# ───────── Расходы на ИИ ─────────
# Одновременных запросов к Claude
AI_MAX_CONCURRENT=8
# Общий дневной бюджет на все клиники, USD (0 — без лимита). Лимит клиники — limits.daily_budget_usd в её файле
AI_DAILY_BUDGET_USD=100
# Больше стольких ответов бота одному чату в час / в сутки — пауза и уведомление администратору
MAX_TURNS_PER_HOUR=40
MAX_TURNS_PER_DAY=150

# ───────── Уведомления администраторам ─────────
# Токен бота от @BotFather. chat_id указываются в файле клиники (notifications.telegram_chat_ids)
TELEGRAM_BOT_TOKEN=

# ───────── Админ-API и веб-симулятор ─────────
# Токен владельца сервиса (от 32 символов). Без него и без токенов клиник админ-API выключен.
ADMIN_TOKEN=
# true — тестовый чат на /simulator (отдельная база). В production работает только вместе с ADMIN_TOKEN.
SIMULATOR_ENABLED=true

# ───────── Сервер и данные ─────────
PORT=3000
DATABASE_PATH=./data/app.db
CLINICS_DIR=./clinics
# Домен для HTTPS (docker-compose + Caddy)
DOMAIN=

# ───────── Резервные копии ─────────
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# ───────── Поведение диалога ─────────
# Сколько мс ждать следующих сообщений пациента перед ответом
DEBOUNCE_MS=2500
# На сколько часов бот замолкает в чате после передачи администратору
HANDOFF_HOURS=12
HISTORY_MAX_TURNS=20
HISTORY_DAYS=14

# ───────── Напоминания ─────────
REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_MIN=5
