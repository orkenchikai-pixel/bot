{
  "name": "dental-crm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ИИ-администратор стоматологической клиники для WhatsApp: запись на приём, прайс-лист, ответы на вопросы, напоминания",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "chat": "tsx src/cli/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "token": "tsx src/cli/token.ts",
    "test:coverage": "vitest run --coverage",
    "redteam": "tsx scripts/redteam.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
